/* Offline privacy and public support. */
"privacy.overview.title" = "Об этой странице";
"privacy.overview.offline" = "Эта информация включена в RedactLeaf. Её можно читать без подключения к сети и без покупки. Внешние страницы открываются только при нажатии на ссылку.";
"privacy.overview.processing" = "RedactLeaf обрабатывает выбранные PDF и изображения на устройстве, в том числе распознаёт текст средствами Apple Vision. В приложении нет сервера документов, рекламы, сервиса аналитики, обязательного аккаунта или собственной облачной синхронизации.";
"privacy.files.title" = "Рабочая область и временные файлы";
"privacy.files.workspace" = "Оригиналы не изменяются. Рабочие страницы, правки и результаты распознавания находятся в памяти. Команда «Очистить рабочую область» удаляет страницы и правки; запрос может оставаться в поле поиска, пока вы не очистите его или не перезапустите приложение. После перезапуска создаётся новая рабочая область; возвращение из фона её не очищает.";
"privacy.files.temporary" = "RedactLeaf создаёт локальные копии для импорта и экспорта. Приложение пытается удалить копии импорта после завершения или отмены операции, а временные файлы экспорта — после завершения или закрытия меню «Поделиться». Приложение также пытается удалить оставшиеся файлы рабочей области при создании новой области после перезапуска. Незавершённая операция или ошибка файловой системы может задержать очистку.";
"privacy.queue.title" = "Очередь общих файлов";
"privacy.queue.copies" = "При передаче файлов в RedactLeaf из другого приложения локальные копии сохраняются в очереди расширения. Они могут содержать исходные личные данные и имена файлов: добавление в очередь ничего не скрывает. Для очереди используется защита файлов iOS; она исключена из резервного копирования.";
"privacy.queue.deletion" = "Приложение пытается удалить пакет после успешного импорта или по команде «Удалить из очереди» либо «Очистить всю очередь». При ошибке или отмене импорта пакет остаётся. Копии старше 24 часов подлежат очистке при следующей проверке очереди основным приложением; активный импорт сохраняется до завершения его обработки. Фоновое удаление ровно через 24 часа не гарантируется. Очистка рабочей области не очищает эту очередь.";
"privacy.presets.title" = "Шаблоны областей";
"privacy.presets.storage" = "Шаблоны сохраняются на этом устройстве между запусками. Они содержат идентификатор, введённое вами имя и относительные координаты прямоугольников, без изображений документов, распознанного текста, исходных имён файлов или файловых URL. Защищённая локальная библиотека исключена из резервного копирования и не синхронизируется. Эти меры хранения не гарантируют безвозвратного стирания.";
"privacy.presets.deletion" = "Выбирайте нейтральные имена шаблонов без личных данных. Удаляйте отдельные шаблоны или выберите «Удалить все шаблоны» в разделе «Шаблоны областей». Очистка рабочей области не удаляет шаблоны. Удаление шаблона не убирает области, уже применённые к странице.";
"privacy.presets.placement" = "Шаблон применяется к выбранной странице. Он не распознаёт документы и не выравнивает поля автоматически. Другая разметка, поворот или пропорции страницы могут изменить положение областей; проверьте их размещение и каждую страницу перед экспортом.";
"privacy.sharing.title" = "Проверка и отправка";
"privacy.sharing.review" = "Распознавание текста предлагает скрыть целые строки. Оно может пропустить текст, рукописные записи, лица, подписи и другие личные детали. Подтвердите предложения или добавьте области вручную, затем проверьте каждую страницу в итоговом просмотре.";
"privacy.sharing.output" = "Экспорт создаёт новые копии из изображений с нейтральными именами файлов. Вид страниц и аннотаций преобразуется в пиксели. Скрытый текст, интерактивные объекты, вложения и метаданные исходника не копируются, но новые файлы содержат технические сведения формата. Выделяемый текст и структура доступности теряются; разрешение может уменьшиться. Оставшиеся видимыми личные данные попадут в экспорт.";
"privacy.sharing.recipients" = "Вы выбираете место назначения в системном меню «Поделиться». Приложения, сервисы хранения и получатели управляют своими копиями; RedactLeaf не может отозвать или удалить их. Провайдер, выбранный в «Файлах», может использовать собственный облачный сервис и требовать подключения к сети.";
"privacy.apple.title" = "Сервисы покупок Apple";
"privacy.apple.services" = "Покупка Pro и восстановление доступа используют Apple StoreKit и App Store и могут требовать подключения к сети. RedactLeaf читает сведения о продукте и транзакциях для определения доступа к Pro, но не получает реквизиты платёжной карты и не отправляет записи о транзакциях на сервер разработчика. Восстановление покупок возвращает доступ, а не документы или шаблоны.";
"privacy.support.title" = "Публичная поддержка";
"privacy.support.public" = "Для проекта используется публичный трекер GitHub Issues в аккаунте 4alvit (имя в публичном профиле разработчика: alvit). Обращения можно читать без входа; для публикации нужен аккаунт GitHub. Имя пользователя, текст обращения и вложения общедоступны. Переписка размещается на GitHub.";
"privacy.support.safe" = "Используйте публичные обращения только для несекретных вопросов. Не загружайте личные документы, чеки, платёжные данные или сведения Аккаунта Apple, пароли, токены и полные журналы устройства. Опишите проблему без вложений или создайте пример с вымышленными данными. Перед публикацией снимков экрана проверьте имена файлов и уведомления.";
"privacy.support.help" = "Для разбора проблемы укажите версию приложения и iOS, модель устройства, язык приложения и шаги с вымышленными данными. У разработчика нет серверных копий ваших документов для восстановления или удаления. Очистка локальных данных приложения не удаляет публичные обращения и копии в других сервисах.";
"privacy.online.title" = "Материалы в сети";
"privacy.online.preview" = "Документы по ссылкам относятся к этой предварительной версии приложения. Информация выше доступна без сети; открытие ссылок обращается к внешнему сервису.";
"privacy.online.policy" = "Политика конфиденциальности — предварительная версия";
"privacy.online.guide" = "Руководство по поддержке — предварительная версия";
"privacy.online.issues" = "Открыть публичные обращения GitHub";
"privacy.online.hint" = "При нажатии открывает внешнюю страницу. Нужно подключение к сети.";
